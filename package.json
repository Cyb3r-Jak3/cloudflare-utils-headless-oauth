{
  "name": "cloudflare-utils-headless-oauth",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "drizzle-kit generate",
    "db:apply": "wrangler d1 migrations apply cloudflare-utils-headless-oauth --local",
    "db:apply:remote": "wrangler d1 migrations apply cloudflare-utils-headless-oauth --remote",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4-de6c356",
    "hono": "^4.12.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "drizzle-kit": "1.0.0-rc.4-ca0f029",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}