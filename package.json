{
  "name": "cloudflare-utils-headless-oauth",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "drizzle-kit generate",
    "db:apply": "wrangler d1 migrations apply cloudflare-utils-headless-oauth --local",
    "db:apply:remote": "wrangler d1 migrations apply cloudflare-utils-headless-oauth --remote",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@cyb3r-jak3/workers-common": "^6.0.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "^4.12.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "^5.0.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vitest": "^5.0.0",
    "wrangler": "^4.118.0"
  }
}